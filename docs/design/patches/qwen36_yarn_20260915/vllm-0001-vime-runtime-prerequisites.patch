         ]
 
         params_dict = dict(self.named_parameters())
+        # [RL weight-sync fix] After process_weights_after_loading, FusedMoE experts.{w13,w2}_weight
+        # are replaced by fresh Parameter objects that lost their weight_loader attr. A *re-load*
+        # of weights (e.g. RL/HCCL weight-sync, per-expert under EP) then reaches the expert path
+        # with a param that has no weight_loader -> AttributeError. Re-attach the owning FusedMoE
+        # module's own (layout-aware, non-local-expert-skipping) weight_loader. No-op on first load
+        # and for modules that already have it. Mirrors sglang's _override_weight_loader.
+        #
+        # [2026-08-05 ported from /workspace/vllm (0.21.0)] 0.23 迁移时漏了这块 → 双机真训练首次跑到
+        # weight-sync 就在 :396 `param.weight_loader` 崩(前 36 个张量正常)。attr 丢失点在
+        # fused_moe/unquantized_fused_moe_method.py:178 replace_parameter → layer_utils.py:35 分支
+        # 重新 register 新 Parameter。**不能用 default_weight_loader 兜底**:它不认 shard_id/expert_id,
+        # 会静默写错权重(不报错但 rollout 用错参数),必须挂回 FusedMoE 自己的 loader。
+        from vllm.model_executor.utils import set_weight_attrs as _set_weight_attrs
+
+        for _module in self.modules():
+            _moe_loader = getattr(_module, "weight_loader", None)
+            if callable(_moe_loader):
+                for _wname in ("w13_weight", "w2_weight"):
+                    _wp = getattr(_module, _wname, None)
+                    if _wp is not None and not hasattr(_wp, "weight_loader"):
+                        _set_weight_attrs(_wp, {"weight_loader": _moe_loader})
         loaded_params: set[str] = set()
         expert_params_mapping = self.get_expert_mapping()
         is_fused_expert = False
-        base_layer = (
-            "base_layer." if any(".base_layer." in name for name in params_dict) else ""
-        )
-        fused_expert_params_mapping = [
-            (f"experts.{base_layer}w13_weight", "experts.gate_up_proj", 0, "w1"),
-            (f"experts.{base_layer}w2_weight", "experts.down_proj", 0, "w2"),
-        ]
+        fused_expert_params_mapping: list[tuple[str, str, int, str]] = []
+        for param_name, ckpt_name, _, shard_id in fused_moe_make_expert_params_mapping(
+            self,
+            ckpt_gate_proj_name="gate_up_proj",
+            ckpt_down_proj_name="down_proj",
+            ckpt_up_proj_name="gate_up_proj",
+            num_experts=1,
+        ):
+            if shard_id == "w3":
+                continue
+            parts = ckpt_name.split(".")
+            fused_expert_params_mapping.append(
+                (f"{param_name}weight", f"{parts[0]}.{parts[2]}", 0, shard_id)
+            )
         num_experts = (
             self.config.num_experts if hasattr(self.config, "num_experts") else 0
         )
