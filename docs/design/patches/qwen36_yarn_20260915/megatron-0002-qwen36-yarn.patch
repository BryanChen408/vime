@@ -0,0 +1,123 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+
+import pytest
+import torch
+from transformers import PreTrainedConfig
+from transformers.modeling_rope_utils import _compute_yarn_parameters
+
+from megatron.core.models.common.embeddings.rope_utils import _apply_rotary_pos_emb_bshd
+from megatron.core.models.common.embeddings.rotary_pos_embedding import RotaryEmbedding
+from megatron.core.models.common.embeddings.yarn_rotary_pos_embedding import YarnRotaryEmbedding
+
+
+@pytest.fixture
+def cpu_yarn(monkeypatch):
+    monkeypatch.setattr(torch.cuda, 'current_device', lambda: torch.device('cpu'))
+    monkeypatch.setattr(YarnRotaryEmbedding, '_set_cos_sin_cache', lambda *args, **kwargs: None)
+
+    return YarnRotaryEmbedding(
+        kv_channels=256,
+        rotary_percent=0.25,
+        rotary_base=10_000_000,
+        scaling_factor=4.0,
+        original_max_position_embeddings=262_144,
+        beta_fast=32.0,
+        beta_slow=1.0,
+        mscale=1.0,
+        mscale_all_dim=0.0,
+        correction_range_round_to_int=True,
+        use_cpu_initialization=True,
+    )
+
+
+def _transformers_yarn_oracle():
+    config = PreTrainedConfig(
+        hidden_size=4096,
+        num_attention_heads=16,
+        head_dim=256,
+        max_position_embeddings=262_144,
+        rope_parameters={
+            'rope_type': 'yarn',
+            'rope_theta': 10_000_000.0,
+            'partial_rotary_factor': 0.25,
+            'factor': 4.0,
+            'original_max_position_embeddings': 262_144,
+            'beta_fast': 32.0,
+            'beta_slow': 1.0,
+            'mscale': 1.0,
+            'mscale_all_dim': 0.0,
+            'truncate': True,
+        },
+    )
+    return _compute_yarn_parameters(config, device=torch.device('cpu'))
+
+
+def test_qwen36_partial_rotary_matches_transformers(cpu_yarn):
+    expected_inv_freq, expected_attention_scale = _transformers_yarn_oracle()
+    unit_position_emb, attention_scale = cpu_yarn.get_emb(1, offset=1)
+    actual_inv_freq = unit_position_emb[0, 0, 0, : cpu_yarn.dim // 2]
+
+    assert cpu_yarn.dim == 64
+    assert cpu_yarn.inv_freq_extra.shape == (32,)
+    assert cpu_yarn.inv_freq_inter.shape == (32,)
+    torch.testing.assert_close(actual_inv_freq, expected_inv_freq, rtol=0, atol=0)
+    assert attention_scale == pytest.approx(expected_attention_scale, abs=0, rel=0)
+    assert attention_scale == pytest.approx(1.138629436111989)
+
+
+@pytest.mark.parametrize('position', [0, 1, 131_071, 262_143, 262_144, 524_287, 1_009_999])
+def test_qwen36_partial_rotary_cos_sin_matches_transformers(cpu_yarn, position):
+    expected_inv_freq, expected_attention_scale = _transformers_yarn_oracle()
+    actual_emb, actual_attention_scale = cpu_yarn.get_emb(1, offset=position)
+    expected_freqs = torch.outer(torch.tensor([position], dtype=torch.float32), expected_inv_freq)
+    expected_emb = torch.cat((expected_freqs, expected_freqs), dim=-1)[:, None, None, :]
+
+    torch.testing.assert_close(
+        actual_emb.cos() * actual_attention_scale,
+        expected_emb.cos() * expected_attention_scale,
+        rtol=1e-6,
+        atol=1e-6,
+    )
+    torch.testing.assert_close(
+        actual_emb.sin() * actual_attention_scale,
+        expected_emb.sin() * expected_attention_scale,
+        rtol=1e-6,
+        atol=1e-6,
+    )
+
+
+def test_partial_rotary_preserves_qk_tail(cpu_yarn):
+    torch.manual_seed(1234)
+    qk = torch.randn(2, 1, 2, 256)
+    freqs, _ = cpu_yarn.get_emb(2)
+
+    rotated = _apply_rotary_pos_emb_bshd(qk, freqs)
+
+    assert not torch.equal(rotated[1, ..., :64], qk[1, ..., :64])
+    assert torch.equal(rotated[..., 64:], qk[..., 64:])
+
+
+def test_factor_one_matches_standard_rope(monkeypatch):
+    monkeypatch.setattr(torch.cuda, 'current_device', lambda: torch.device('cpu'))
+    monkeypatch.setattr(YarnRotaryEmbedding, '_set_cos_sin_cache', lambda *args, **kwargs: None)
+    yarn = YarnRotaryEmbedding(
+        kv_channels=256,
+        rotary_percent=0.25,
+        rotary_base=10_000_000,
+        scaling_factor=1.0,
+        original_max_position_embeddings=262_144,
+        use_cpu_initialization=True,
+    )
+    rope = RotaryEmbedding(
+        kv_channels=256,
+        rotary_percent=0.25,
+        rotary_base=10_000_000,
+        use_cpu_initialization=True,
+    )
+
+    yarn_emb, yarn_scale = yarn.get_emb(8)
+    rope_emb = rope(8)
+
+    assert yarn_scale == 1.0
+    torch.testing.assert_close(yarn_emb, rope_emb, rtol=0, atol=0)
+    assert yarn.state_dict() == rope.state_dict() == {}
