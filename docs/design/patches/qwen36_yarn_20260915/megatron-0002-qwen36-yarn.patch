+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+
+import argparse
+
+import torch
+
+from megatron.training.arguments import add_megatron_arguments, core_transformer_config_from_args
+
+
+def _parse_and_build_config(extra_args):
+    parser = add_megatron_arguments(argparse.ArgumentParser(allow_abbrev=False))
+    args = parser.parse_args(
+        [
+            '--num-layers',
+            '2',
+            '--hidden-size',
+            '256',
+            '--num-attention-heads',
+            '1',
+            '--kv-channels',
+            '256',
+            '--ffn-hidden-size',
+            '512',
+            '--no-rope-fusion',
+            *extra_args,
+        ]
+    )
+    args.params_dtype = torch.float32
+    return args, core_transformer_config_from_args(args)
+
+
+def test_non_mla_yarn_cli_maps_to_transformer_config():
+    args, config = _parse_and_build_config(
+        [
+            '--position-embedding-type',
+            'yarn',
+            '--rotary-scaling-factor',
+            '4.0',
+            '--yarn-original-max-position-embeddings',
+            '262144',
+            '--yarn-beta-fast',
+            '24.0',
+            '--yarn-beta-slow',
+            '2.0',
+            '--mscale',
+            '1.5',
+            '--mscale-all-dim',
+            '0.5',
+            '--no-yarn-correction-range-round-to-int',
+        ]
+    )
+
+    assert args.position_embedding_type == 'yarn'
+    assert config.yarn_rotary_scaling_factor == 4.0
+    assert config.yarn_original_max_position_embeddings == 262144
+    assert config.yarn_beta_fast == 24.0
+    assert config.yarn_beta_slow == 2.0
+    assert config.yarn_mscale == 1.5
+    assert config.yarn_mscale_all_dim == 0.5
+    assert config.yarn_correction_range_round_to_int is False
+
+
+def test_non_mla_yarn_config_uses_embedding_defaults():
+    _, config = _parse_and_build_config(['--position-embedding-type', 'yarn'])
+
+    assert config.yarn_rotary_scaling_factor == 1.0
+    assert config.yarn_original_max_position_embeddings == 4096
+    assert config.yarn_beta_fast == 32.0
+    assert config.yarn_beta_slow == 1.0
+    assert config.yarn_mscale == 1.0
+    assert config.yarn_mscale_all_dim == 0.0
+    assert config.yarn_correction_range_round_to_int is True
+
+
+def test_standard_rope_does_not_add_yarn_config():
+    _, config = _parse_and_build_config(['--position-embedding-type', 'rope'])
+
+    assert not hasattr(config, 'yarn_rotary_scaling_factor')
