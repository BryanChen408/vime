+            k=k,
+            w=w,
+            g=g,
+            gk=gk,
+            dht=dht,
+            dh0=dh0,
+            do=do,
+            dh=dh,
+            dv=dv,
+            dv2=dv2,
+            cu_seqlens=cu_seqlens,
+            chunk_offsets=chunk_offsets,
+            scale=scale,
+            T=T,
+            H=H,
+            K=K,
+            V=V,
+            BT=BT,
+            BV=BV,
+        )
+    else:
+        chunk_gated_delta_rule_bwd_kernel_dhu_blockdim64_var[(triton.cdiv(V, BV), N * H)](
