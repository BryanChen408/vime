@@ -0,0 +1,215 @@
+# Copyright (c) 2025 Huawei Technologies Co., Ltd. All Rights Reserved.
+# This file is a part of the vllm-ascend project.
+"""HCCL-based weight transfer engine for Ascend RL training."""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterator
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+import torch
+
+if TYPE_CHECKING:
+    from vllm_ascend.distributed.device_communicators.pyhccl import PyHcclCommunicator
+
+from vllm.config.parallel import ParallelConfig
+from vllm.config.weight_transfer import WeightTransferConfig
+from vllm.distributed.weight_transfer.base import (
+    WeightTransferEngine,
+    WeightTransferInitInfo,
+    WeightTransferUpdateInfo,
+)
+
+from vllm_ascend.distributed.device_communicators.pyhccl import PyHcclCommunicator
+
+
+@dataclass
+class HCCLWeightTransferInitInfo(WeightTransferInitInfo):
+    master_address: str
+    master_port: int
+    rank_offset: int
+    world_size: int
+
+
+@dataclass
+class HCCLTrainerSendWeightsArgs:
+    group: Any
+    src: int = 0
+    post_iter_func: Callable[[tuple[str, torch.Tensor]], torch.Tensor] | None = None
+    packed: bool = False
+    stream: torch.npu.Stream | None = None
+
+
+@dataclass
+class HCCLWeightTransferUpdateInfo(WeightTransferUpdateInfo):
+    names: list[str]
+    dtype_names: list[str]
+    shapes: list[list[int]]
+    packed: bool = False
+
+    def __post_init__(self):
+        num_params = len(self.names)
+        if len(self.dtype_names) != num_params:
+            raise ValueError(
+                f"`dtype_names` should be of the same size as `names`: got {len(self.dtype_names)} and {len(self.names)}"
+            )
+        if len(self.shapes) != num_params:
+            raise ValueError(
+                f"`shapes` should be of the same size as `names`: got {len(self.shapes)} and {len(self.names)}"
+            )
+
+
+class HCCLWeightTransferEngine(
+    WeightTransferEngine[HCCLWeightTransferInitInfo, HCCLWeightTransferUpdateInfo]
+):
+    init_info_cls = HCCLWeightTransferInitInfo
+    update_info_cls = HCCLWeightTransferUpdateInfo
+
+    def __init__(self, config: WeightTransferConfig, parallel_config: ParallelConfig) -> None:
+        super().__init__(config, parallel_config)
+        self.model_update_group: PyHcclCommunicator | None = None
+
+    def init_transfer_engine(self, init_info: HCCLWeightTransferInitInfo) -> None:
+        dp_rank = self.parallel_config.data_parallel_index
+        world_size_per_dp = self.parallel_config.world_size
+        rank_within_dp = self.parallel_config.rank
+        worker_rank = dp_rank * world_size_per_dp + rank_within_dp
+        rank = worker_rank + init_info.rank_offset
+        device = torch.npu.current_device()
+        self.model_update_group = HCCLWeightTransferEngine._stateless_init_process_group(
+            init_info.master_address,
+            init_info.master_port,
+            rank,
+            init_info.world_size,
+            device=device,
+        )
+
+    def receive_weights(
+        self,
+        update_info: HCCLWeightTransferUpdateInfo,
+        load_weights: Callable[[list[tuple[str, torch.Tensor]]], None],
+    ) -> None:
+        if self.model_update_group is None:
+            raise RuntimeError(
+                "HCCL weight transfer not initialized. Call init_transfer_engine() first."
+            )
+
+        if update_info.packed:
+            # Packed path: pack many params into ~1GB buffers, one broadcast +
+            # one load_weights per buffer (mirrors NCCL packed path). Dominant fix
+            # for the per-tensor serial round-trip cost that made HCCL weight sync
+            # 5-6x slower than sglang.
+            from vllm_ascend.distributed.weight_transfer.packed_tensor_npu import (
+                packed_broadcast_consumer_npu,
+            )
+
+            def state_dict_info_iterator():
+                for name, dtype_name, shape in zip(
+                    update_info.names,
+                    update_info.dtype_names,
+                    update_info.shapes,
+                    strict=True,
+                ):
+                    yield (name, (shape, getattr(torch, dtype_name)))
+
+            packed_broadcast_consumer_npu(
+                iterator=state_dict_info_iterator(),
+                group=self.model_update_group,
+                src=0,
+                post_unpack_func=load_weights,
+            )
+            return
+
+        # Batched receive (sglang-equivalent, non-packed path — the one MoE uses):
+        # enqueue all broadcasts on the stream, then a SINGLE load_weights for the
+        # whole bucket, instead of per-tensor broadcast→load([one])→del. Mirrors
+        # sglang's model_runner (fire all broadcasts async → wait → one
+        # model.load_weights(weights)). Cuts the tens-of-thousands of per-tensor
+        # load_weights Python/dispatch round-trips that made vime→vLLM weight sync
+        # 5-6x slower than slime→sglang. Receiver-only change: the trainer still
+        # broadcasts per tensor in the same order, we just defer the load.
+        # Peak extra = one bucket (bounded by --update-weight-buffer-size), and the
+        # checkpoint-format wrapper already buffers per layer regardless.
+        weights: list[tuple[str, torch.Tensor]] = []
+        for name, dtype_name, shape in zip(
+            update_info.names,
+            update_info.dtype_names,
+            update_info.shapes,
+            strict=True,
+        ):
+            dtype = getattr(torch, dtype_name)
+            weight = torch.empty(shape, dtype=dtype, device="npu")
+            self.model_update_group.broadcast(weight, src=0)
+            weights.append((name, weight))
+        load_weights(weights)
+
+    def shutdown(self) -> None:
+        self.model_update_group = None
+
+    @staticmethod
+    def trainer_send_weights(
+        iterator: Iterator[tuple[str, torch.Tensor]],
+        trainer_args: dict[str, Any] | HCCLTrainerSendWeightsArgs,
+    ) -> None:
+        if isinstance(trainer_args, dict):
+            args = HCCLTrainerSendWeightsArgs(**trainer_args)
+        else:
+            args = trainer_args
+
+        if args.post_iter_func is None:
+            post_iter_func = lambda x: x[1]
+        else:
+            post_iter_func = args.post_iter_func
+
+        if args.packed:
+            # Packed path: pack params into ~1GB buffers, one broadcast per buffer
+            # (mirrors NCCL packed producer). Must stay in lockstep with the
+            # consumer's default buffer_size_bytes/num_buffers.
+            from vllm_ascend.distributed.weight_transfer.packed_tensor_npu import (
+                packed_broadcast_producer_npu,
+            )
+
+            packed_broadcast_producer_npu(
+                iterator=iterator,
+                group=args.group,
+                src=args.src,
+                post_iter_func=post_iter_func,
+            )
+            return
+
+        for item in iterator:
+            tensor = post_iter_func(item)
+            args.group.broadcast(tensor, src=args.src, stream=args.stream)
+
+    @staticmethod
+    def trainer_init(init_info: HCCLWeightTransferInitInfo | dict) -> "PyHcclCommunicator":
+        if isinstance(init_info, dict):
+            master_address = init_info["master_address"]
+            master_port = init_info["master_port"]
+            world_size = init_info["world_size"]
+        else:
+            master_address = init_info.master_address
+            master_port = init_info.master_port
+            world_size = init_info.world_size
+
+        device = torch.npu.current_device()
+        return HCCLWeightTransferEngine._stateless_init_process_group(
+            master_address,
+            master_port,
+            0,
+            world_size,
+            device,
+        )
+
+    @staticmethod
+    def _stateless_init_process_group(master_address, master_port, rank, world_size, device):
+        from vllm.distributed.utils import StatelessProcessGroup
+
+        pg = StatelessProcessGroup.create(
+            host=master_address,
+            port=master_port,
+            rank=rank,
+            world_size=world_size,
+        )
+        return PyHcclCommunicator(pg, device=device)
