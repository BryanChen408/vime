+"""Polar agentic-RL per-request telemetry(engine 真值)。
+
+由 gateway 注入的 `x-polar-trace-id`(="{session_id}:{turn_seq}")关联,从 vllm 的
+最终 RequestOutput 抽 TTFT/prefill/decode/queue/prefix-cache/抢占,写一行 JSONL,与 polar
+gateway 的 completion_metrics.jsonl 在 trace_id 上 join。
+
+自包含(不依赖 polar 仓);观测绝不打断推理:所有路径 try/except + 后台有界队列写。
+接入见本仓 serving.py 两处 hook。落盘 $POLAR_ENGINE_METRICS_DIR/<engine_id>.jsonl。
+engine_id 来自 $POLAR_ENGINE_ID(每 engine 进程设),缺省用 $VLLM_PORT 或 'engine'。
+"""
+from __future__ import annotations
+
+import contextvars
+import json
+import os
+import queue
+import sys
+import threading
+from datetime import datetime, timezone
+from typing import Any
+
+# 引擎侧默认落盘目录(共享 FS,免在 vime 引擎启动处设环境变量即可开箱写)。
+# 想改路径:export POLAR_ENGINE_METRICS_DIR=<dir>。
+_DEFAULT_METRICS_DIR = "/mnt/share/polar_engine_metrics"
+
+# 同一 async 任务链内传递 trace_id(create_chat_completion → full_generator)
+_TRACE: contextvars.ContextVar[str | None] = contextvars.ContextVar("polar_trace_id", default=None)
+
+_LOGGER = None
+_LOCK = threading.Lock()
+
+
+def set_trace(trace_id: str | None) -> None:
+    try:
+        _TRACE.set(trace_id)
+    except Exception:
+        pass
+
+
+def _engine_id() -> str:
+    """自动 engine 身份(免配置):POLAR_ENGINE_ID > $VLLM_PORT > 启动 --port > pid。
+    每 engine 端口不同 → 天然区分 3 个推理 engine;分析侧用 card_topology 的 engine_endpoints 端口映射。"""
+    eid = os.environ.get("POLAR_ENGINE_ID")
+    if eid:
+        return eid
+    port = os.environ.get("VLLM_PORT")
+    if not port:
+        argv = sys.argv or []
+        for i, a in enumerate(argv):
+            if a == "--port" and i + 1 < len(argv):
+                port = argv[i + 1]
+                break
+            if a.startswith("--port="):
+                port = a.split("=", 1)[1]
+                break
+    return f"engine-{port}" if port else f"engine-{os.getpid()}"
+
+
+def _getattr_any(obj, *names, default=None):
+    for n in names:
+        v = getattr(obj, n, None)
+        if v is not None:
+            return v
+    return default
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def extract(ro: Any, *, engine_id: str, trace_id: str | None,
+            serve_t0: float | None = None, serve_t_first: float | None = None,
+            serve_t_end: float | None = None) -> dict[str, Any]:
+    m = getattr(ro, "metrics", None)
+    arrival = _getattr_any(m, "arrival_time")
+    first_sched = _getattr_any(m, "first_scheduled_time")
+    first_token = _getattr_any(m, "first_token_time")
+    finished = _getattr_any(m, "finished_time")
+    time_in_queue = _getattr_any(m, "time_in_queue")
+
+    prompt_ids = getattr(ro, "prompt_token_ids", None)
+    n_prompt = len(prompt_ids) if prompt_ids is not None else _getattr_any(m, "num_prompt_tokens")
+    n_cached = _getattr_any(ro, "num_cached_tokens", default=None)
+    outs = getattr(ro, "outputs", None) or []
+    n_gen = sum(len(getattr(o, "token_ids", []) or []) for o in outs) if outs else None
+    finish_reason = getattr(outs[0], "finish_reason", None) if outs else None
+    aborted = (getattr(ro, "finished", True) is False) or (finish_reason == "abort")
+
+    n_prefill = (n_prompt - n_cached) if (n_prompt is not None and n_cached is not None) else n_prompt
+    prefix_hit = round(100.0 * n_cached / n_prompt, 2) if (n_prompt and n_cached is not None) else None
+
+    def ms(a, b):
+        return round((b - a) * 1000.0, 3) if (a is not None and b is not None) else None
+
+    queue_ms = round(time_in_queue * 1000.0, 3) if time_in_queue is not None else ms(arrival, first_sched)
+    ttft_ms = ms(arrival, first_token)
+    prefill_ms = ms(first_sched, first_token)
+    decode_ms = ms(first_token, finished)
+    # V1 兜底:engine RequestMetrics 不填时间 → serving 层自测。
+    # 但非流式(gateway 用 stream=False)下 V1 只 yield 一次(在最后),首token≈结束 → 拆不出 ttft/decode。
+    # 故:只有"真流式"(首token与结束有明显间隔 >50ms)才用 serve 拆 ttft/decode;否则只报 e2e,
+    # ttft/decode 留 None(不造假 decode_tps)。queue/prefill 始终需引擎内部,serving 层拆不出。
+    timing_source = "engine" if ttft_ms is not None else None
+    serve_e2e_ms = round((serve_t_end - serve_t0) * 1000.0, 3) if (serve_t0 is not None and serve_t_end is not None) else None
+    _serve_split = (serve_t_first is not None and serve_t_end is not None
+                    and (serve_t_end - serve_t_first) > 0.05)
+    if ttft_ms is None and _serve_split and serve_t0 is not None:
+        ttft_ms = round((serve_t_first - serve_t0) * 1000.0, 3)
+        decode_ms = round((serve_t_end - serve_t_first) * 1000.0, 3)
+        timing_source = "serve_split"
+    elif timing_source is None and serve_e2e_ms is not None:
+        timing_source = "serve_e2e"   # 非流式:只有端到端总时长,拆不出 ttft/decode
+    decode_tps = round(n_gen / (decode_ms / 1000.0), 3) if (n_gen and decode_ms and decode_ms > 0) else None
+
+    sid, turn = None, None
+    if trace_id and ":" in trace_id:
+        sid, _, t = trace_id.partition(":")
+        turn = int(t) if t.isdigit() else None
+
+    return {
+        "schema_version": 1, "engine_id": engine_id, "trace_id": trace_id,
+        "session_id": sid, "turn_seq": turn, "request_id": getattr(ro, "request_id", None),
+        "recorded_at": _now_iso(),
+        "num_prompt_tokens": n_prompt, "num_cached_tokens": n_cached,
+        "num_prefill_tokens": n_prefill, "num_generation_tokens": n_gen,
+        "prefix_cache_hit_pct": prefix_hit,
+        "arrival_ts": arrival, "first_scheduled_ts": first_sched,
+        "first_token_ts": first_token, "finished_ts": finished,
+        "queue_ms": queue_ms, "ttft_ms": ttft_ms, "prefill_ms": prefill_ms, "decode_ms": decode_ms,
+        "serve_e2e_ms": serve_e2e_ms, "decode_tps_engine": decode_tps, "timing_source": timing_source,
+        "num_preemptions": _getattr_any(m, "num_preemptions", default=None),
+        "finish_reason": finish_reason, "aborted": aborted,
+    }
+
+
+class _Writer:
+    def __init__(self, engine_id: str):
+        base = os.environ.get("POLAR_ENGINE_METRICS_DIR") or _DEFAULT_METRICS_DIR
+        try:
+            os.makedirs(base, exist_ok=True)
+        except Exception:
+            pass
+        self.path = os.path.join(base, f"{engine_id}.jsonl")
+        self._q: queue.Queue = queue.Queue(maxsize=16384)
+        self.dropped = 0
+        threading.Thread(target=self._drain, daemon=True).start()
+
+    def put(self, row: dict[str, Any]) -> None:
+        try:
+            self._q.put_nowait(row)
+        except queue.Full:
+            self.dropped += 1
+
+    def _drain(self) -> None:
+        try:
+            with open(self.path, "a", buffering=1) as f:
+                while True:
+                    row = self._q.get()
+                    try:
+                        f.write(json.dumps(row, ensure_ascii=False) + "\n")
+                    except Exception:
+                        pass
+        except Exception:
+            pass
+
+
+def _writer() -> _Writer:
+    global _LOGGER
+    if _LOGGER is None:
+        with _LOCK:
+            if _LOGGER is None:
+                _LOGGER = _Writer(_engine_id())
+    return _LOGGER
+
+
+def log_final(request_output: Any, *, serve_t0: float | None = None,
+              serve_t_first: float | None = None, serve_t_end: float | None = None) -> None:
+    """在 full_generator 拿到 final RequestOutput 后调用。serve_t* 为 serving 层自测时间(V1 兜底)。绝不抛。"""
+    try:
+        if os.environ.get("POLAR_ENGINE_METRICS_DISABLE") == "1":
+            return
+        trace_id = _TRACE.get()
+        row = extract(request_output, engine_id=_engine_id(), trace_id=trace_id,
+                      serve_t0=serve_t0, serve_t_first=serve_t_first, serve_t_end=serve_t_end)
+        _writer().put(row)
+    except Exception:
+        pass
